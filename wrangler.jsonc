{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decomp-fun",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only sign-in and submissions run code; every other request is a static file.
    "run_worker_first": ["/auth/*", "/api/*"]
  },
  "vars": {
    // Public OAuth client ID from https://github.com/settings/developers (not a secret).
    "GITHUB_CLIENT_ID": "SET_ME",
    "SITE_REPO": "g-guthrie/decomp.fun"
  },
  // Secrets (npx wrangler secret put NAME): GITHUB_CLIENT_SECRET, SESSION_SECRET, GITHUB_DISPATCH_TOKEN
  "kv_namespaces": [{ "binding": "LIMITS", "id": "71c484c694c74617bcb03778a70b95fd" }],
  "routes": [
    { "pattern": "decomp.fun", "custom_domain": true },
    { "pattern": "www.decomp.fun", "custom_domain": true }
  ]
}
